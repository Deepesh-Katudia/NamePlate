# Copy to .env and fill in. .env is gitignored: never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Monitoring windows (simulated data source in the prototype)
WINDOW_DURATION_S=16
SAMPLE_RATE_HZ=5000
# Seconds between background window runs for every asset; 0 disables the loop
TELEMETRY_INTERVAL_S=0
# Commission and degrade the twelve-motor demo fleet when the API starts
SEED_ON_STARTUP=false
